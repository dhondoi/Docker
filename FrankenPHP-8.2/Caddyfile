{
	# Menerima IP Asli dari Cloudflare via Proxy
	trusted_proxies static private_ranges {
		client_ip_headers CF-Connecting-IP
	}
}

:80 {
	# Root folder Laravel
	root * /app/public

	# Batas ukuran upload (client_max_body_size 10M)
	request_body {
		max_size 10MB
	}

	# Optimasi Kompresi (Gzip & Zstd)
	encode gzip zstd

	# Security Headers & Sembunyikan Header Identitas Server/PHP
	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		X-XSS-Protection "1; mode=block"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Referrer-Policy "no-referrer-when-downgrade"
		Content-Security-Policy "default-src 'self' http: https: data: blob: 'unsafe-inline'"
		-X-Powered-By
		-Server
	}

	# Restriksi HTTP Method
	@invalid_method not method GET POST HEAD PUT PATCH DELETE OPTIONS
	error @invalid_method 405

	# Hardening: Blokir eksekusi PHP di folder storage Laravel
	@php_in_storage path /storage/*.php
	error @php_in_storage 403

	# Hardening: Blokir akses ke file/folder tersembunyi (.env, .git, dll)
	@dotfiles {
		path /.*
		not path /.well-known/*
	}
	error @dotfiles 403

	# Optimasi Browser Caching untuk Aset Statis
	@static path_regexp static \.(jpg|jpeg|png|gif|ico|css|js|eot|ttf|woff|woff2|svg)$
	header @static Cache-Control "public, max-age=31536000, no-transform"

	# KHUSUS FRANKENPHP: Menggantikan php_fastcgi dan try_files Laravel
	php_server

	# Melayani file statis
	file_server
}
